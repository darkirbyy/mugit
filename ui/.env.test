# Mandatory parameters
KERNEL_CLASS='App\Kernel'
APP_DEBUG=0

# Override some parameters
APP_SECRET='$ecretf0rt3st'
MOCK_KEYCLOAK_ENABLE=true

CORE_CONNECTION_TIMEOUT=2
CORE_REPO_WARN_SIZE_PERCENT=75

# All these variables are also used as overrides for docker compose
# to start a second instance of the core for the tests
CORE_NAME=mugit_test
# CORE_UID=<yyyy>           # must be same as in the core
# CORE_GID=<yyyy>           # must be same as in the core
CORE_DATA="./data/test"     # relative to the core directory
CORE_PORT=30022
CORE_NETWORK_EXTERNAL=false
CORE_NETWORK_UI_ADDR="*"
CORE_REPO_MAX_SIZE_MIO=5
