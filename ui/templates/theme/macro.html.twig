{# HELP : textKey is the key before translation, mode must be :
  - 'normal': text + no tooltip
  - 'tooltip': no text + tooltip
  - 'off': no text + no tooltip 
  #}
{% macro button(textKey, icon = null, mode = 'normal', attr = null) %}
  {% set attr = { class: [] }|merge(attr|default([])) %}
  {% set class = 'rounded px-2 py-1 opacity-75 hover:cursor-pointer hover:bg-zinc-300 hover:opacity-100 dark:hover:bg-zinc-800'|split(' ') %}

  {% if mode == 'tooltip' %}
    {% set class = class|merge('after:absolute after:translate-x-3 after:-translate-y-2 after:z-30 after:hidden after:rounded after:text-sm after:p-2'|split(' ')) %}
    {% set class = class|merge('after:border after:border-zinc-500 after:bg-zinc-300 hover:after:inline-block dark:after:bg-zinc-800'|split(' ')) %}
    {% set attr = attr|html_attr_merge({ 'data-tooltip': textKey|trans }) %}
  {% endif %}
  {% if mode == 'off' or mode == 'tooltip' %}
    {% set attr = attr|html_attr_merge({ 'aria-label': textKey|trans }) %}
  {% endif %}
  {% set attr = attr|html_attr_merge({ class: class }) %}

  <button {{ html_attr(attr) }}>
    {% if icon is not null %}
      <span class="{{ icon }}" aria-hidden="true"></span>
    {% endif %}
    {% if mode == 'normal' %}
      <span class="ml-1">{{ textKey|trans }}</span>
    {% endif %}
  </button>
{% endmacro %}

{# HELP : textKey is the key before translation #}
{% macro link(textKey, path, attr = null) %}
  {% set attr = { class: [] }|merge(attr|default([])) %}
  {% set class = 'font-bold underline opacity-75 hover:opacity-100'|split(' ') %}

  {% set attr = attr|html_attr_merge({ class: class }) %}

  <a href="{{ path }}" {{ html_attr(attr) }}>{{ textKey|trans }}</a>
{% endmacro %}

{# HELP : type can be 'info', 'success', 'warning' or 'error', textKey is the key before translation #}
{% macro flash(type, id, textKey, canRetry = true, canClose = true) %}
  {% set typeToVars = {
    info: { icon: 'information', color: 'bg-sky-200 dark:bg-sky-950' },
    success: { icon: 'shield-check', color: 'bg-green-200 dark:bg-green-950' },
    warning: { icon: 'alert', color: 'bg-amber-200 dark:bg-amber-950' },
    error: { icon: 'spam', color: 'bg-red-200 dark:bg-red-950' }
  } %}
  {% set vars = attribute(typeToVars, type) %}
  <div data-controller="flash">
    <div id="{{ id }}" class="rounded border border-zinc-500/50 {{ vars.color }} mb-4 flex items-center p-2 text-sm" role="alert">
      <div class="flex items-center gap-1.5 rounded-full bg-zinc-500/25 px-2">
        <span class="ri-{{ vars.icon }}-line text-lg" aria-hidden="true"></span>
        <span class="font-bold">{{ ('layout.flash.' ~ type)|trans }}</span>
      </div>
      <div class="mx-2">
        {{ textKey|trans }}
        {% if canRetry %}
          {{ _self.link('layout.flash.tryAgain', '#', { 'data-action': 'click->turboframe#reload' }) }}
        {% endif %}
      </div>
      {% if canClose %}
        <button
          type="button"
          class="ms-auto inline-flex h-8 w-8 shrink-0 items-center justify-center rounded hover:cursor-pointer hover:bg-zinc-500/25"
          aria-label="{{ 'layout.flash.close'|trans }}"
          data-action="click->flash#dismiss"
        >
          <span class="ri-close-line text-lg" aria-hidden="true"></span>
        </button>
      {% endif %}
    </div>
  </div>
{% endmacro %}

{# HELP : #}
{% macro dropdown_start(id, attr = null) %}
  {% set attr = { class: [] }|merge(attr|default([])) %}
  {% set class = 'z-10 hidden rounded border border-zinc-500 bg-zinc-200 shadow-lg shadow-zinc-300 dark:bg-zinc-950 dark:shadow-zinc-950'|split(' ') %}
  {% set attr = attr|html_attr_merge({ class: class }) %}

  {{ _self.tag_open('div') }} id="{{ id }}" {{ html_attr(attr) }}>
  {{ _self.tag_open('ul') }} class="p-1">
{% endmacro %}

{# HELP : #}
{% macro dropdown_end() %}
  {{ _self.tag_close('ul') }}>
  {{ _self.tag_close('div') }}>
{% endmacro %}

{# HELP : tag can be 'a' or 'button', textKey is the key before translation, extra can be:
- null: nothing addd
- an icon (starting with 'ri-'): added at the end
- some content: tag is forced to 'button', a responsive icon is added at the end, a stimulus controller is set
#}
{% macro dropdown_item(tag, textKey, icon = null, attr = null, extra = null) %}
  {% set attr = { class: [] }|merge(attr|default([])) %}
  {% set class = 'inline-flex w-full items-center justify-between rounded px-1 py-0.5 text-left hover:cursor-pointer hover:bg-zinc-300 dark:hover:bg-zinc-800'|split(' ') %}
  {% set attr = attr|html_attr_merge({ class: class }) %}

  {% if extra is null or extra starts with 'ri-' %}
    <li>
      {% if tag == 'button' %}
        <button {{ html_attr(attr) }}>{{ _self.dropdown_item_insert(textKey, icon, extra) }}</button>
      {% else %}
        <a {{ html_attr(attr) }}>{{ _self.dropdown_item_insert(textKey, icon, extra) }}</a>
      {% endif %}
    </li>
  {% else %}
    <li data-controller="dropdown" data-dropdown-class-open-value="ri-arrow-down-s-line" data-dropdown-class-unopen-value="ri-arrow-right-s-line">
      <button {{ html_attr(attr) }} data-dropdown-target="button">{{ _self.dropdown_item_insert(textKey, icon, 'ri-arrow-right-s-line') }}</button>
      <div class="hidden" data-dropdown-target="content">
        <div class="my-1 ml-1 border-l-4 border-zinc-500/50 pl-2">
          {{ extra|raw }}
        </div>
      </div>
    </li>
  {% endif %}
{% endmacro %}

{# HELP : internal macro #}
{% macro dropdown_item_insert(textKey, iconStart = null, iconEnd = null) %}
  <div>
    {% if iconStart is not null %}
      <span class="{{ iconStart }} my-0.5 pr-2" aria-hidden="true"></span>
    {% endif %}
    {{ textKey|trans }}
  </div>
  <div>
    {% if iconEnd is not null %}
      <span class="{{ iconEnd }}" aria-hidden="true"></span>
    {% endif %}
  </div>
{% endmacro %}

{# HELP : #}
{% macro dropdown_separator() %}
  <li><hr class="-mx-1 my-1 border-zinc-500" /></li>
{% endmacro %}

{# HELP : #}
{% macro tag_open(tag) %}
  {{ ('<' ~ tag)|raw }}
{% endmacro %}

{# HELP : #}
{% macro tag_close(tag) %}
  {{ ('</' ~ tag)|raw }}
{% endmacro %}

{# HELP : #}
{% macro spinner(number = 1, bordered = false, gridClass = 'p-2 gap-2 grid-cols-1', itemClass = 'h-6', ) %}
  <div class="grid {{ gridClass }} {{ bordered ? 'border-zinc-500/25 rounded border' }} motion-safe:animate-pulse" aria-label="{{ 'aria.loading'|trans }}">
    {% for n in 1..number %}
      <div class="{{ itemClass }} rounded bg-zinc-500/25"></div>
    {% endfor %}
  </div>
{% endmacro %}
