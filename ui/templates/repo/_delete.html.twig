{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-repo-delete-{{ repoDeleteData.name }}">
  {% set formName = 'repo-delete-' ~ repoDeleteData.name %}
  {{ m.form_start(formName) }}
  <div class="flex min-w-2xs flex-col gap-0.5 pt-0.5">
    <div class="flex items-center gap-1 text-red-900 dark:text-red-400">
      <div class="flex-1 px-1">
        {{ 'repo.delete.label'|trans }}
      </div>
      {{ m.form_submit(formName, 'form.delete', 'ri-delete-bin-line') }}
    </div>
  </div>
  <input type="hidden" name="name" value="{{ repoDeleteData.name }}" />
  {{ m.form_end(formName, formData) }}
</turbo-frame>
