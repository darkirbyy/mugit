{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-repo-list">
  {% if constant('class', repoListOutput) ends with 'CoreError' %}
    {{ m.alert('repo.error.' ~ repoListOutput.messageKey, 'repo-list-' ~ repoListOutput.messageKey, 'error') }}
  {% else %}
    <div class="relative rounded border border-zinc-500 shadow-xs">
      <div class="flex flex-col border-b border-zinc-500 bg-zinc-200 px-2 py-2 lg:flex-row lg:items-center lg:justify-between dark:bg-zinc-900">
        <div></div>
        <div class="flex shrink-0 flex-col gap-2 md:flex-row md:items-center lg:justify-end">
          {{ m.button('repo.list.createNew', 'ri-add-large-line', 'normal') }}
          {{ m.button('repo.list.refresh', 'ri-reset-left-line', 'tooltip', { 'data-controller': 'reload-frame' }) }}
        </div>
      </div>
      <div>
        <table
          class="w-full text-left"
          data-controller="copy-clipboard"
          data-copy-clipboard-class-checked-value="ri-check-double-line text-green-700 dark:text-green-300"
          data-copy-clipboard-class-unchecked-value="ri-file-copy-line"
          data-copy-clipboard-copied-text-value="{{ 'repo.list.copied'|trans }}"
        >
          <thead class="border-b border-zinc-500 bg-zinc-300 font-bold dark:bg-zinc-800">
            <tr>
              <th scope="col" class="px-4 pr-2">{{ 'repo.list.name'|trans }}</th>
              <th scope="col" class="px-4 py-2">
                {{ 'repo.list.humanReadableSize'|trans }}
                <span class="text-base font-medium">{{ m.button('repo.list.humanReadableSizeHelp', 'ri-question-line', 'tooltip') }}</span>
              </th>
              <th scope="col" class="px-4 py-2">{{ 'repo.list.cloneURL'|trans }}</th>
              <th scope="col" class="w-8 px-2 py-2" aria-label="{{ 'repo.list.edit'|trans }}"></th>
            </tr>
          </thead>
          <tbody>
            {% for repoInfo in repoListOutput.repoInfoList %}
              <tr class="border-zinc-500 bg-zinc-200 dark:bg-zinc-900 {{ not loop.last ? ' border-b' }}">
                <th class="px-4 py-2 font-medium whitespace-nowrap">{{ repoInfo.name }}</th>
                <td class="px-4 py-2">{{ repoInfo.humanReadableSize }}</td>
                <td class="px-4 py-2" data-copy-clipboard-target="cell">
                  <span class="mr-1">{{ repoInfo.cloneURL }}</span>
                  {{ m.button('repo.list.copyURLToClipboard', 'ri-file-copy-line', 'tooltip') }}
                </td>
                <td class="px-2 py-2 text-left">
                  {% set dropdownId = 'dropdown-repo-' ~ loop.index0 %}
                  {{ m.button('repo.list.edit', 'ri-more-2-line', 'icon', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'left-start' }) }}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" class="px-4 py-2 text-sm italic">{{ 'repo.list.noRepo'|trans }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <div>
      {% for repoInfo in repoListOutput.repoInfoList %}
        {% set dropdownId = 'dropdown-repo-' ~ loop.index0 %}

        {{ m.dropdown_start(dropdownId, { class: ['min-w-40'] }) }}
        {% set extra %}
          {{ m.dropdown_start(dropdownId ~ '-rename', { class: ['min-w-40'] }) }}
          <turbo-frame role="none" id="turboframe-repo-rename" loading="lazy" src="{{ path('repo_rename', { oldName: repoInfo.name }) }}">
            {{ m.spinner() }}
          </turbo-frame>
          {{ m.dropdown_end() }}
        {% endset %}
        {% set attr = { 'data-dropdown-toggle': dropdownId ~ '-rename', 'data-dropdown-placement': 'left-start' } %}
        {{ m.dropdown_item('repo.list.rename', 'button', 'ri-pencil-line', 'ri-arrow-right-s-line', attr, extra) }}
        {{ m.dropdown_item('repo.list.delete', 'button', 'ri-delete-bin-line', 'ri-arrow-right-s-line', { class: ['text-red-900', 'dark:text-red-400'] }) }}
        {{ m.dropdown_end() }}
      {% endfor %}
    </div>
  {% endif %}
</turbo-frame>
