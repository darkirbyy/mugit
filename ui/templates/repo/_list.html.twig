{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-repo-list">
  {% if coreErrorData is not null %}
    {{ m.flash('error', coreErrorData.textKey, true, false) }}
  {% else %}
    <div class="relative rounded border border-zinc-500 bg-zinc-200 shadow-xs dark:bg-zinc-900">
      <div class="flex flex-col border-b border-zinc-500 px-2 py-2 lg:flex-row lg:items-center lg:justify-between">
        <div></div>
        <div class="flex shrink-0 flex-col gap-2 md:flex-row md:items-center lg:justify-end">
          {{ m.button('repo.list.createNew', 'ri-add-large-line', 'normal') }}
          {{ m.button('repo.list.refresh', 'ri-reset-left-line', 'tooltip', { 'data-action': 'click->turboframe#reload' }) }}
        </div>
      </div>
      <div>
        <table class="w-full text-left" data-controller="copy-clipboard" data-copy-clipboard-copied-text-value="{{ 'repo.list.copied'|trans }}">
          <thead class="border-b border-zinc-500 bg-zinc-300 font-bold dark:bg-zinc-800">
            <tr>
              <th scope="col" class="px-4 pr-2">{{ 'repo.list.name'|trans }}</th>
              <th scope="col" class="px-4 py-2">
                {{ 'repo.list.humanReadableSize'|trans }}
                <span class="text-base font-medium">{{ m.button('repo.list.humanReadableSizeHelp', 'ri-question-line', 'tooltip') }}</span>
              </th>
              <th scope="col" class="px-4 py-2">{{ 'repo.list.cloneURL'|trans }}</th>
              <th scope="col" class="w-8 px-2 py-2" aria-label="{{ 'repo.list.edit'|trans }}"></th>
            </tr>
          </thead>
          <tbody>
            {% for repoInfoData in repoListData.repoInfoDataList %}
              <tr class="border-zinc-500 {{ not loop.last ? ' border-b' }}">
                <th class="px-4 py-2 font-medium whitespace-nowrap">{{ repoInfoData.name }}</th>
                <td class="px-4 py-2">
                  {{ repoInfoData.humanReadableSize }}
                  {% if repoInfoData.size > env.core.repo_max_size_mio * 1024 * env.core.repo_warn_size_percent / 100 %}
                    <div class="inline-block">
                      {{ m.flash_mini('warning', 'repo.list.warnSize') }}
                    </div>
                  {% endif %}
                </td>
                <td class="px-4 py-2" data-copy-clipboard-target="cell">
                  <span class="mr-1">{{ repoInfoData.cloneURL }}</span>
                  {{ m.button('repo.list.copyURLToClipboard', 'ri-file-copy-line', 'tooltip') }}
                </td>
                <td class="px-2 py-2 text-left">
                  {% set dropdownId = 'dropdown-repo-' ~ loop.index0 %}
                  {{ m.button('repo.list.edit', 'ri-more-2-line', 'off', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'left-start' }) }}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" class="px-4 py-2 text-sm italic">{{ 'repo.list.noRepo'|trans }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <div>
      {# todo : only one, with duplicatable template ? #}
      {% for repoInfoData in repoListData.repoInfoDataList %}
        {% set dropdownId = 'dropdown-repo-' ~ loop.index0 %}
        {{ m.dropdown_start(dropdownId, { class: ['min-w-60'] }) }}
        {% set extra %}
          <turbo-frame role="none" id="turboframe-repo-rename" loading="lazy" src="{{ path('repo_rename', { 'old-name': repoInfoData.name }) }}" data-controller="turboframe">
            {{ m.spinner() }}
          </turbo-frame>
        {% endset %}
        {{ m.dropdown_item('button', 'repo.list.rename', 'ri-pencil-line', null, extra) }}
        {% if is_granted('ROLE_ADMIN') %}
          {% set extra %}
            <turbo-frame role="none" id="turboframe-repo-delete" loading="lazy" src="{{ path('repo_delete', { name: repoInfoData.name }) }}" data-controller="turboframe">
              {{ m.spinner() }}
            </turbo-frame>
          {% endset %}
          {{ m.dropdown_item('button', 'repo.list.delete', 'ri-delete-bin-line', { class: ['text-red-900', 'dark:text-red-400'] }, extra) }}
          {{ m.dropdown_end() }}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</turbo-frame>
