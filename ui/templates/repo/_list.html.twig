{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-repo-list">
  {% if errorData is not null %}
    {{ m.flash('flash-error-repo-list', 'error', errorData.textKey, 'full', true, false) }}
  {% else %}
    <div class="rounded border border-zinc-500 bg-zinc-200 shadow-xs dark:bg-zinc-900">
      <div class="flex min-w-2xs items-center justify-end gap-1 border-b border-zinc-500 px-2 py-2">
        {% set buttonId = 'button-repo-create' %}
        {% set dropdownId = 'dropdown-repo-create' %}
        {% set turboframeId = 'turboframe-repo-create' %}
        {{ m.button(buttonId, 'repo.list.createNew', 'ri-add-large-line', 'normal', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'bottom-end' }) }}
        {{ m.dropdown_start(dropdownId, { class: ['min-w-60'] }) }}
        <turbo-frame id="{{ turboframeId }}" loading="lazy" src="{{ path('repo_create') }}" data-controller="turboframe">
          {{ m.spinner(2, false, 'p-1 gap-1 grid-cols-1 min-w-2xs') }}
        </turbo-frame>
        {{ m.dropdown_end() }}
        {{ m.button('button-repo-refresh', 'repo.list.refresh', 'ri-reset-left-line', 'tooltip', { 'data-action': 'click->turboframe#reload' }) }}
      </div>
      <div class="overflow-auto">
        <table class="w-full text-left" data-controller="copy-clipboard" data-copy-clipboard-copied-text-value="{{ 'repo.list.copied'|trans }}">
          <thead class="border-b border-zinc-500 bg-zinc-300 font-bold dark:bg-zinc-800">
            <tr>
              <th scope="col" class="px-4 pr-2">{{ 'repo.list.name'|trans }}</th>
              <th scope="col" class="px-4 py-2 whitespace-nowrap">
                {{ 'repo.list.humanReadableSize'|trans }}
                <span class="text-base font-medium">{{ m.button('button-repo-help-size', 'repo.list.humanReadableSizeHelp', 'ri-question-line', 'tooltip') }}</span>
              </th>
              <th scope="col" class="px-4 py-2">{{ 'repo.list.cloneURL'|trans }}</th>
              <th scope="col" class="w-8 px-2 py-2" aria-label="{{ 'repo.list.edit'|trans }}"></th>
            </tr>
          </thead>
          <tbody>
            {% for repoInfoData in repoListData.repoInfoDataList %}
              <tr class="border-zinc-500 {{ not loop.last ? ' border-b' }}">
                <td class="px-4 py-2 font-medium whitespace-nowrap">{{ repoInfoData.name }}</td>
                <td class="px-4 py-2 whitespace-nowrap">
                  {{ repoInfoData.size|repo_size_to_human_readable }}
                  {% if repoInfoData.size > env.core.repo_max_size_mio * 1024 * env.core.repo_warn_size_percent / 100 %}
                    <div class="inline-block">
                      {{ m.flash('flash-warning-repo-size-' ~ repoInfoData.name, 'warning', 'repo.list.warnSize', 'mini') }}
                    </div>
                  {% endif %}
                </td>
                <td class="px-4 py-2 whitespace-nowrap" data-copy-clipboard-target="cell">
                  <span class="mr-1">{{ repoInfoData.name|repo_name_to_clone_URL }}</span>
                  {% set buttonId = 'button-repo-copy-url-' ~ repoInfoData.name %}
                  {{ m.button(buttonId, 'repo.list.copyURLToClipboard', 'ri-file-copy-line', 'tooltip') }}
                </td>
                <td class="px-2 py-2 text-left">
                  {% set buttonId = 'button-repo-edit-' ~ repoInfoData.name %}
                  {% set dropdownId = 'dropdown-repo-edit-' ~ repoInfoData.name %}
                  {% set turboframeRenameId = 'turboframe-repo-rename-' ~ repoInfoData.name %}
                  {% set turboframeDeleteId = 'turboframe-repo-delete-' ~ repoInfoData.name %}
                  {{ m.button(buttonId, 'repo.list.edit', 'ri-more-2-line', 'off', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'left-start' }) }}
                  {{ m.dropdown_start(dropdownId, { class: ['min-w-60'] }) }}
                  {% set extra %}
                    <turbo-frame id="{{ turboframeRenameId }}" loading="lazy" src="{{ path('repo_rename', { 'old-name': repoInfoData.name }) }}" data-controller="turboframe">
                      {{ m.spinner(1, false, 'p-1 gap-1 grid-cols-1 min-w-2xs') }}
                    </turbo-frame>
                  {% endset %}
                  {% set buttonId = 'button-repo-rename-' ~ repoInfoData.name %}
                  {{ m.dropdown_item(buttonId, 'button', 'repo.list.rename', 'ri-pencil-line', null, extra) }}
                  {% if is_granted('ROLE_ADMIN') %}
                    {% set extra %}
                      <turbo-frame id="{{ turboframeDeleteId }}" loading="lazy" src="{{ path('repo_delete', { name: repoInfoData.name }) }}" data-controller="turboframe">
                        {{ m.spinner(1, false, 'p-1 gap-1 grid-cols-1 min-w-2xs') }}
                      </turbo-frame>
                    {% endset %}
                    {% set buttonId = 'button-repo-delete-' ~ repoInfoData.name %}
                    {{ m.dropdown_item(buttonId, 'button', 'repo.list.delete', 'ri-delete-bin-line', { class: ['text-red-900', 'dark:text-red-400'] }, extra) }}
                  {% endif %}
                  {{ m.dropdown_end() }}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" class="px-4 py-2 text-sm italic">{{ 'repo.list.noRepo'|trans }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}
</turbo-frame>
