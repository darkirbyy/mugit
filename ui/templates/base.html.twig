{% import 'theme/macro.html.twig' as m %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if (turboForceReload|default(false)) == true %}
      <meta name="turbo-visit-control" content="reload" />
    {% endif %}
    <meta name="turbo-prefetch" content="{{ env.turbo.enable_prefetch ? 'true' : 'false' }}" />

    <link rel="icon" href="{{ asset('build/images/favicon.png') }}" />

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-100 text-zinc-900 dark:bg-zinc-900 dark:text-zinc-100">
    {# DEBUG: Bar to show the environment, not visible in prod #}
    {% if env.app.env != 'prod' %}
      <div class="z-40 m-0 flex justify-around p-0 text-center font-bold app-env-{{ env.app.env }}">
        {%- for i in 1..10 -%}
          <div>
            {{ ('layout.debug.env.' ~ env.app.env)|trans|upper }}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}

    {# DEBUG: Button to switch role, onyl visible in dev/test and if keycloak is mocked #}
    {% if (env.app.env == 'dev' or env.app.env == 'test') and env.mock.keycloak_enable %}
      <div class="absolute right-0 z-50 bg-red-400 px-2 font-semibold hover:bg-red-500 dark:bg-red-950 dark:hover:bg-red-800">
        <a id="link-switch-role" href="{{ path('home_switch') }}" data-turbo-prefetch="false">
          {{ ('layout.debug.switchRole'|trans|upper) ~ ' ' ~ (app.user.isAdmin ? 'USER' : 'ADMIN') }}
        </a>
      </div>
    {% endif %}

    {# ACCESSIBILITY: Skip to content link for screen reader #}
    <div class="absolute z-40 mx-auto mt-2 w-full -translate-y-10 text-center transition duration-200 focus-within:translate-y-0 motion-reduce:duration-0">
      <a
        id="link-skip-content"
        class="rounded border border-zinc-500 bg-zinc-100 px-2 py-1 focus-within:outline-2 focus-within:outline-zinc-800 dark:bg-zinc-900 dark:focus-within:outline-zinc-200"
        href="#main-content"
        data-turbo="false"
      >
        {{ 'aria.skipToContent'|trans }}
      </a>
    </div>

    {# HEADER: contains the navbar #}
    <header class="flex items-center justify-between border-b border-zinc-500 bg-zinc-200 px-1 py-1 dark:bg-zinc-950">
      {# Header left part #}
      <ul>
        <li>
          <a
            id="link-header-home"
            href="{{ path('home_index') }}"
            class="m-0.5 rounded px-2 py-1 font-bold focus-within:bg-zinc-300 focus-within:outline-2 focus-within:outline-zinc-800 hover:cursor-pointer hover:bg-zinc-300 dark:focus-within:bg-zinc-800 dark:focus-within:outline-zinc-200 dark:hover:bg-zinc-800"
          >
            {{ 'layout.name'|trans }}
          </a>
        </li>
      </ul>
      {# Header right part #}
      <nav>
        <button
          id="button-navbar-menu"
          class="m-0.5 rounded px-2 py-1 focus-within:bg-zinc-300 focus-within:outline-2 focus-within:outline-zinc-800 hover:cursor-pointer hover:bg-zinc-300 dark:focus-within:bg-zinc-800 dark:focus-within:outline-zinc-200 dark:hover:bg-zinc-800"
          data-dropdown-toggle="dropdown-navbar-menu"
          data-dropdown-placement="bottom-end"
          aria-label="{{ 'aria.toggleNavigation'|trans }}"
        >
          <span class="font-bold">{{ app.user.username }}</span>
          <img
            class="mb-0.5 ml-1.5 inline size-6 rounded-full border border-zinc-500 object-cover"
            src="{{ app.user.toArray.picture }}"
            alt="{{ 'aria.avatar'|trans({ name: app.user.username }) }}"
          />
        </button>

        {# Menu dropdown #}
        {{ m.dropdown_start('dropdown-navbar-menu', { class: ['w-full sm:w-auto min-w-60 sm:rounded'], 'data-controller': 'dropdown' }) }}
        <li>
          <div class="flex flex-row items-center gap-3 py-0.5">
            <div class="py-1 pl-2">
              <img
                class="size-12 rounded-full border border-zinc-500 object-cover"
                src="{{ app.user.toArray.picture }}"
                alt="{{ 'aria.avatar'|trans({ name: app.user.username }) }}"
              />
            </div>
            <div class="flex grow flex-col justify-center px-1 py-2">
              <div class="h-5 text-base font-bold">
                {{ app.user.username ~ (is_granted('ROLE_ADMIN') ? ' (' ~ ('layout.navbar.admin'|trans) ~ ')') }}
              </div>
              {% if app.user.email is not empty %}
                <div class="text-sm text-zinc-800 dark:text-zinc-300">
                  {{ app.user.email }}
                </div>
              {% endif %}
            </div>
            <div class="self-start">
              <button
                class="rounded px-2 py-1 focus-within:bg-zinc-500/25 focus-within:outline-2 focus-within:outline-zinc-800 hover:cursor-pointer hover:bg-zinc-500/25 dark:focus-within:outline-zinc-200"
                data-action="click->dropdown#close"
                aria-label="{{ 'layout.flash.close'|trans }}"
              >
                <span class="ri-close-line text-lg" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </li>
        {{ m.dropdown_separator() }}
        {{ m.dropdown_item('link-navbar-my-ssh-key', 'a', 'layout.navbar.mySSHKeys', 'ri-key-2-line', { href: path('user_keys_index') }) }}
        {% if is_granted('ROLE_ADMIN') %}
          {% set extra %}
            <ul>
              {{ m.dropdown_item('button-navbar-tools-keys', 'a', 'layout.navbar.tools.users', 'ri-user-settings-line', { href: path('admin_users_index') }) }}
              {{ m.dropdown_item('button-navbar-tools-logs', 'a', 'layout.navbar.tools.logs', 'ri-chat-history-line', { href: '#' }) }}
            </ul>
          {% endset %}
          {{ m.dropdown_item('button-navbar-admin', 'button', 'layout.navbar.admin', 'ri-lock-2-line', [], extra) }}
        {% endif %}
        {% set extra %}
          <ul data-controller="switch-theme">
            {% for theme, icon in { light: 'ri-sun-line', dark: 'ri-moon-line', auto: 'ri-settings-line' } %}
              {% set attr = { 'data-switch-theme-target': 'button ' ~ theme } %}
              {{ m.dropdown_item('button-navbar-theme-' ~ theme, 'button', 'layout.navbar.theme.' ~ theme, icon, attr, 'ri-check-line') }}
            {% endfor %}
          </ul>
        {% endset %}
        {{ m.dropdown_item('button-navbar-appearance', 'button', 'layout.navbar.appearance', 'ri-palette-line', [], extra) }}
        {{ m.dropdown_separator() }}
        {% set attr = { href: env.iam.base_url, 'data-turbo-prefetch': false } %}
        {{ m.dropdown_item('link-navbar-my-account', 'a', 'layout.navbar.myAccount', 'ri-user-line', attr, 'ri-external-link-line') }}
        {% set attr = { href: env.hub.base_url, 'data-turbo-prefetch': false } %}
        {{ m.dropdown_item('link-navbar-back-to-hub', 'a', 'layout.navbar.backToHub', 'ri-home-4-line', attr, 'ri-external-link-line') }}
        {% set attr = { href: path('mainick_keycloak_security_auth_logout'), 'data-turbo-prefetch': false, 'data-turbo': false, class: ['text-red-900', 'dark:text-red-400'] } %}
        {{ m.dropdown_item('link-navbar-sign-out', 'a', 'layout.navbar.signOut', 'ri-logout-circle-r-line', attr, 'ri-external-link-line') }}
        {{ m.dropdown_end() }}
      </nav>
    </header>

    {# MAIN #}
    <main class="mx-auto w-full grow p-4 md:w-2xl lg:w-4xl xl:w-6xl" id="main-content">
      {# Heading : same as title if not defined #}
      <h1 class="mt-2 mb-8 text-3xl font-bold">{{ heading|default(title) }}</h1>

      {# Flash messages #}
      {% for type in ['info', 'success', 'warning', 'error'] %}
        {% for flash in app.flashes(type) %}
          {{ m.flash('flash-' ~ type ~ '-main-' ~ loop.index0, type, flash.textKey, 'full', flash.canRetry, flash.canClose) }}
        {% endfor %}
      {% endfor %}

      {# The block 'main' must be redefined on each page #}
      {% block main %}

      {% endblock %}
    </main>

    {# FOOTER: framework and versioning #}
    <footer class="mt-2 flex gap-6 border-t border-zinc-500 bg-zinc-200 p-3 text-sm font-light text-zinc-800 italic dark:bg-zinc-950 dark:text-zinc-300">
      <div class="grow text-right">
        {{ 'layout.footer.madeWith'|trans }}
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="mr-0.5 inline pb-0.5" width="1rem" height="1rem" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M12 .9C5.8.9.9 5.8.9 12a11 11 0 1 0 22.2 0A11 11 0 0 0 12 .9zm6.5 6c-.6 0-.9-.3-.9-.8 0-.2 0-.4.2-.6l.2-.4c0-.3-.5-.4-.6-.4-1.8.1-2.3 2.5-2.7 4.4l-.2 1c1 .2 1.8 0 2.2-.3.6-.4-.2-.7-.1-1.2.1-.3.5-.5.7-.6.5 0 .7.5.7.9 0 .7-1 1.8-3 1.8l-.6-.1-.6 2.4c-.4 1.6-.8 3.8-2.4 5.7-1.4 1.7-2.9 1.9-3.5 1.9-1.2 0-1.9-.6-2-1.5 0-.8.7-1.3 1.2-1.3.6 0 1.1.5 1.1 1s-.2.6-.4.6c-.1.1-.3.2-.3.4 0 .1.1.3.4.3.5 0 .8-.3 1.1-.5 1.2-.9 1.6-2.7 2.2-5.7l.1-.7.7-3.2c-.8-.6-1.3-1.4-2.4-1.7-.6-.1-1.1.1-1.5.5-.4.5-.2 1.1.2 1.5l.7.6c.7.8 1.2 1.6 1 2.5-.3 1.5-2 2.6-4 1.9-1.8-.6-2-1.8-1.8-2.5.2-.6.6-.7 1.1-.6.5.2.6.7.6 1.2l-.1.3c-.2.1-.3.3-.3.4-.1.4.4.6.7.7.7.3 1.6-.2 1.8-.8a1 1 0 0 0-.4-1.1l-.7-.8c-.4-.4-1.1-1.4-.7-2.6.1-.5.4-.9.7-1.3a4 4 0 0 1 2.8-.6c1.2.4 1.8 1.1 2.6 1.8.5-1.2 1-2.4 1.8-3.5.9-.9 1.9-1.6 3.1-1.7 1.3.2 2.2.7 2.2 1.6 0 .4-.2 1.1-.9 1.1z"
          ></path>
        </svg>Symfony 7
        {{ 'layout.footer.and'|trans }}
        <span class="ri-tailwind-css-fill" aria-hidden="true"></span>
        Tailwind CSS 4
      </div>
      <div class="grow text-left">
        {{ ('layout.footer.version'|trans) ~ ' ' ~ env.versioning.version ~ ' - ' ~ ('layout.footer.releaseDate'|trans) ~ ' '
          ~ (env.versioning.release_date|format_datetime('short', 'none')) }}
      </div>
    </footer>
  </body>
</html>
