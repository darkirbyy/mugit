<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if (turbo_force_reload|default(false)) == true %}
      <meta name="turbo-visit-control" content="reload" />
    {% endif %}
    <meta name="turbo-prefetch" content="{{ env.turbo.enable_prefetch ? 'true' : 'false' }}" />

    <link rel="icon" href="{{ asset('build/images/favicon.png') }}" />

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>
  </head>
  <body class="flex flex-col min-h-screen text-zinc-900 bg-zinc-100 dark:text-zinc-100 dark:bg-zinc-900">
    {# Bar to show the environment, not visible in prod #}
    {% if env.app.env != 'prod' %}
      <div class="flex z-40 justify-around p-0 m-0 text-center font-bold app-env-{{ env.app.env }}">
        {%- for i in 1..10 -%}
          <div>
            {{ ('layout.env.' ~ env.app.env)|trans|upper }}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}

    {# Button to switch role, onyl visible in dev/test and if keycloak is mocked #}
    {% if (env.app.env == 'dev' or env.app.env == 'test') and env.mock.keycloak_enable %}
      <div class="z-50 absolute right-0 px-2 bg-red-400 font-semibold hover:bg-red-500 dark:bg-red-950 dark:hover:bg-red-800">
        <a href="{{ path('home_switch') }}">PASSER EN ROLE {{ app.user.isAdmin ? 'STANDARD' : 'ADMIN' }}</a>
      </div>
    {% endif %}

    {# Skip to content link for screen reader #}
    <div class="z-40 absolute w-full mx-auto mt-2 text-center -translate-y-10 focus-within:translate-y-0 transition duration-200">
      <a class="border rounded py-1 px-2 border-zinc-500 bg-zinc-300 dark:bg-zinc-950" href="#main-content" data-turbo="false">{{ 'aria.skipToContent'|trans }}</a>
    </div>

    {# Navigation bar #}
    <header class="border-b border-zinc-500 bg-zinc-300 dark:bg-zinc-950 flex">
      <div class="grow">
        <ul>
          <li class="px-2 py-1 m-0.5 font-bold"><a href="{{ path('home_index') }}">{{ 'layout.name'|trans }}</a></li>
        </ul>
      </div>
      <div>
        <button
          class="px-2 py-1 m-0.5 rounded hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
          id="switch-theme-button"
          data-dropdown-toggle="switch-theme"
          aria-label="{{ 'aria.switchTheme'|trans }}"
        >
          <span class="ri-palette-fill" aria-hidden="true"></span>
        </button>
        <div id="switch-theme" class="z-10 hidden min-w-30 rounded border border-zinc-500 bg-zinc-300 dark:bg-zinc-950" data-controller="switch-theme">
          <ul aria-labelledby="switch-theme-button" class="p-1">
            <li>
              <button class="w-full px-1 py-0.5 text-left rounded hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800" data-switch-theme-target="light">
                <span class="my-0.5 pr-1 ri-sun-fill" aria-hidden="true"></span>{{ 'layout.theme.light'|trans }}
              </button>
            </li>
            <li>
              <button class="w-full px-1 py-0.5 text-left rounded hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800" data-switch-theme-target="dark">
                <span class="my-0.5 pr-1 ri-moon-fill" aria-hidden="true"></span>{{ 'layout.theme.dark'|trans }}
              </button>
            </li>
            <li>
              <button class="w-full px-1 py-0.5 text-left rounded hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800" data-switch-theme-target="auto">
                <span class="my-0.5 pr-1 ri-home-gear-fill" aria-hidden="true"></span>{{ 'layout.theme.auto'|trans }}
              </button>
            </li>
          </ul>
        </div>
      </div>
    </header>

    {# DEBUG : TODO remove #}
    <div class="text-left">
      {{ app.user.id }} - {{ app.user.username }} - <img src="{{ app.user.toArray.picture }}" style="display: inline; width: 50px;" /> - {{
        app.user.roles|reduce((carry, value, key) => carry ~ value ~ ', ')
      }}
    </div>

    {# The MAIN block must be redefined on each page, including the flash block with the bood wrapper #}
    <main class="grow" id="main-content">
      {% block main %}
        {# {{ block('flash', 'theme/flash.html.twig') }} #}
        <div class="text-center">
          Some content !
        </div>
      {% endblock %}
    </main>

    {# Footer with framework and versioning #}
    <footer class="border-t border-zinc-500 bg-zinc-300 dark:bg-zinc-950 mt-2 p-2 flex gap-6 font-light italic text-sm">
      <div class="grow text-right">
        {{ 'layout.footer.madeWith'|trans }}
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="inline mr-0.5" width="1rem" height="1rem" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M12 .9C5.8.9.9 5.8.9 12a11 11 0 1 0 22.2 0A11 11 0 0 0 12 .9zm6.5 6c-.6 0-.9-.3-.9-.8 0-.2 0-.4.2-.6l.2-.4c0-.3-.5-.4-.6-.4-1.8.1-2.3 2.5-2.7 4.4l-.2 1c1 .2 1.8 0 2.2-.3.6-.4-.2-.7-.1-1.2.1-.3.5-.5.7-.6.5 0 .7.5.7.9 0 .7-1 1.8-3 1.8l-.6-.1-.6 2.4c-.4 1.6-.8 3.8-2.4 5.7-1.4 1.7-2.9 1.9-3.5 1.9-1.2 0-1.9-.6-2-1.5 0-.8.7-1.3 1.2-1.3.6 0 1.1.5 1.1 1s-.2.6-.4.6c-.1.1-.3.2-.3.4 0 .1.1.3.4.3.5 0 .8-.3 1.1-.5 1.2-.9 1.6-2.7 2.2-5.7l.1-.7.7-3.2c-.8-.6-1.3-1.4-2.4-1.7-.6-.1-1.1.1-1.5.5-.4.5-.2 1.1.2 1.5l.7.6c.7.8 1.2 1.6 1 2.5-.3 1.5-2 2.6-4 1.9-1.8-.6-2-1.8-1.8-2.5.2-.6.6-.7 1.1-.6.5.2.6.7.6 1.2l-.1.3c-.2.1-.3.3-.3.4-.1.4.4.6.7.7.7.3 1.6-.2 1.8-.8a1 1 0 0 0-.4-1.1l-.7-.8c-.4-.4-1.1-1.4-.7-2.6.1-.5.4-.9.7-1.3a4 4 0 0 1 2.8-.6c1.2.4 1.8 1.1 2.6 1.8.5-1.2 1-2.4 1.8-3.5.9-.9 1.9-1.6 3.1-1.7 1.3.2 2.2.7 2.2 1.6 0 .4-.2 1.1-.9 1.1z"
          ></path>
        </svg>Symfony 7
        {{ 'layout.footer.and'|trans }}
        <span class="ri-tailwind-css-fill" aria-hidden="true"></span>
        Tailwind CSS 4
      </div>
      <div class="grow text-left">
        {{ ('layout.footer.version'|trans) ~ ' ' ~ env.versioning.version ~ ' - ' ~ ('layout.footer.releaseDate'|trans) ~ ' '
          ~ (env.versioning.release_date|format_datetime('short', 'none')) }}
      </div>
    </footer>
  </body>
</html>
