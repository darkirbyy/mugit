<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if (turbo_force_reload|default(false)) == true %}
      <meta name="turbo-visit-control" content="reload" />
    {% endif %}
    <meta name="turbo-prefetch" content="{{ env.turbo.enable_prefetch ? 'true' : 'false' }}" />

    <link rel="icon" href="{{ asset('build/images/favicon.png') }}" />

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-100 text-zinc-900 dark:bg-zinc-900 dark:text-zinc-100">
    {# DEBUG: Bar to show the environment, not visible in prod #}
    {% if env.app.env != 'prod' %}
      <div class="z-40 m-0 flex justify-around p-0 text-center font-bold app-env-{{ env.app.env }}">
        {%- for i in 1..10 -%}
          <div>
            {{ ('layout.debug.env.' ~ env.app.env)|trans|upper }}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}

    {# DEBUG: Button to switch role, onyl visible in dev/test and if keycloak is mocked #}
    {% if (env.app.env == 'dev' or env.app.env == 'test') and env.mock.keycloak_enable %}
      <div class="absolute right-0 z-50 bg-red-400 px-2 font-semibold hover:bg-red-500 dark:bg-red-950 dark:hover:bg-red-800">
        <a href="{{ path('home_switch') }}">{{ ('layout.debug.switchRole'|trans|upper) ~ ' ' ~ (app.user.isAdmin ? 'USER' : 'ADMIN') }}</a>
      </div>
    {% endif %}

    {# Skip to content link for screen reader #}
    <div class="absolute z-40 mx-auto mt-2 w-full -translate-y-10 text-center transition duration-200 focus-within:translate-y-0">
      <a class="rounded border border-zinc-500 bg-zinc-100 px-2 py-1 dark:bg-zinc-900" href="#main-content" data-turbo="false">{{ 'aria.skipToContent'|trans }}</a>
    </div>

    {# Navigation bar #}
    <header class="flex justify-between border-b border-zinc-500 bg-zinc-300 px-1 py-1 dark:bg-zinc-950">
      <ul>
        <li class="m-0.5 rounded px-2 py-1 font-bold hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800">
          <a href="{{ path('home_index') }}">{{ 'layout.name'|trans }}</a>
        </li>
      </ul>
      <navbar>
        <button
          class="m-0.5 rounded px-2 py-1 hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
          id="main-menu-button"
          data-dropdown-toggle="main-menu"
          data-dropdown-placement="bottom-end"
          aria-label="{{ 'aria.toggleNavigation'|trans }}"
        >
          <div>
            <span class="font-bold">{{ app.user.username }}</span><img class="mb-0.5 ml-1.5 inline w-6 rounded-full border border-zinc-500" src="{{ app.user.toArray.picture }}" />
          </div>
        </button>
        <div id="main-menu" class="z-10 hidden min-w-60 rounded border border-zinc-500 bg-zinc-300 shadow-lg shadow-zinc-300 dark:bg-zinc-950 dark:shadow-zinc-950">
          <ul class="p-1">
            <li>
              <div class="flex flex-row items-center gap-3 p-2">
                <div>
                  <img class="w-12 rounded-full border border-zinc-500" src="{{ app.user.toArray.picture }}" />
                </div>
                <div class="flex flex-col justify-center">
                  <div class="h-5 text-base font-bold">
                    {{ app.user.username ~ (is_granted('ROLE_ADMIN') ? ' (' ~ ('layout.navbar.admin'|trans) ~ ')') }}
                  </div>
                  {% if app.user.email is not empty %}
                    <div class="text-sm text-zinc-800 dark:text-zinc-300">
                      {{ app.user.email }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </li>
            <li><hr class="-mx-1 my-1 border-zinc-500" /></li>
            <li>
              <a href="#" class="inline-block w-full rounded px-1 py-0.5 hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800">
                <span class="ri-key-2-line my-0.5 pr-2" aria-hidden="true"></span>{{ 'layout.navbar.mySSHKeys'|trans }}
              </a>
            </li>
            <li>
              <button
                class="inline-flex w-full items-center justify-between rounded px-1 py-0.5 text-left hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
                id="switch-theme-button"
                data-dropdown-toggle="switch-theme"
                data-dropdown-placement="left-start"
              >
                <div>
                  <span class="ri-palette-line my-0.5 pr-2" aria-hidden="true"></span>{{ 'layout.navbar.appearance'|trans }}
                </div>
                <div>
                  <span class="ri-arrow-right-s-line" aria-hidden="true"></span>
                </div>
              </button>
              <div
                id="switch-theme"
                class="z-10 hidden min-w-30 rounded border border-zinc-500 bg-zinc-300 shadow-lg shadow-zinc-300 dark:bg-zinc-950 dark:shadow-zinc-950"
                data-controller="switch-theme"
              >
                <ul aria-labelledby="switch-theme-button" class="p-1">
                  <li>
                    <button
                      class="inline-block w-full rounded px-1 py-0.5 text-left hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
                      data-switch-theme-target="light"
                    >
                      <span class="ri-sun-fill my-0.5 pr-1" aria-hidden="true"></span>{{ 'layout.navbar.theme.light'|trans }}
                    </button>
                  </li>
                  <li>
                    <button class="inline-block w-full rounded px-1 py-0.5 text-left hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800" data-switch-theme-target="dark">
                      <span class="ri-moon-fill my-0.5 pr-1" aria-hidden="true"></span>{{ 'layout.navbar.theme.dark'|trans }}
                    </button>
                  </li>
                  <li>
                    <button class="inline-block w-full rounded px-1 py-0.5 text-left hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800" data-switch-theme-target="auto">
                      <span class="ri-home-gear-fill my-0.5 pr-1" aria-hidden="true"></span>{{ 'layout.navbar.theme.auto'|trans }}
                    </button>
                  </li>
                </ul>
              </div>
            </li>
            <li><hr class="-mx-1 my-1 border-zinc-500" /></li>
            <li>
              <a
                href="{{ env.iam.base_url }}"
                data-turbo-prefetch="false"
                class="inline-flex w-full items-center justify-between rounded px-1 py-0.5 hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
              >
                <div>
                  <span class="ri-user-line my-0.5 pr-2" aria-hidden="true"></span>{{ 'layout.navbar.myAccount'|trans }}
                </div>
                <div>
                  <span class="ri-external-link-line" aria-hidden="true"></span>
                </div>
              </a>
            </li>
            <li>
              <a
                href="{{ env.hub.base_url }}"
                data-turbo-prefetch="false"
                class="inline-flex w-full items-center justify-between rounded px-1 py-0.5 hover:cursor-pointer hover:bg-zinc-400 dark:hover:bg-zinc-800"
              >
                <div>
                  <span class="ri-home-4-line my-0.5 pr-2" aria-hidden="true"></span>{{ 'layout.navbar.backToHub'|trans }}
                </div>
                <div>
                  <span class="ri-external-link-line" aria-hidden="true"></span>
                </div>
              </a>
            </li>
            <li>
              <a
                href="{{ path('mainick_keycloak_security_auth_logout') }}"
                data-turbo-prefetch="false"
                data-turbo="false"
                class="inline-block w-full rounded px-1 py-0.5 text-red-900 hover:cursor-pointer hover:bg-zinc-400 dark:text-red-400 dark:hover:bg-zinc-800"
              >
                <span class="ri-logout-circle-r-line my-0.5 pr-2" aria-hidden="true"></span>{{ 'layout.navbar.signOut'|trans }}
              </a>
            </li>
          </ul>
        </div>
      </navbar>
    </header>

    {# The MAIN block must be redefined on each page, including the flash block with the bood wrapper #}
    <main class="grow" id="main-content">
      {% block main %}
        {# {{ block('flash', 'theme/flash.html.twig') }} #}
        <div class="text-center">
          Some content !
        </div>
      {% endblock %}
    </main>

    {# Footer with framework and versioning #}
    <footer class="mt-2 flex gap-6 border-t border-zinc-500 bg-zinc-300 p-3 text-sm font-light text-zinc-800 italic dark:bg-zinc-950 dark:text-zinc-300">
      <div class="grow text-right">
        {{ 'layout.footer.madeWith'|trans }}
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="mr-0.5 inline pb-0.5" width="1rem" height="1rem" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M12 .9C5.8.9.9 5.8.9 12a11 11 0 1 0 22.2 0A11 11 0 0 0 12 .9zm6.5 6c-.6 0-.9-.3-.9-.8 0-.2 0-.4.2-.6l.2-.4c0-.3-.5-.4-.6-.4-1.8.1-2.3 2.5-2.7 4.4l-.2 1c1 .2 1.8 0 2.2-.3.6-.4-.2-.7-.1-1.2.1-.3.5-.5.7-.6.5 0 .7.5.7.9 0 .7-1 1.8-3 1.8l-.6-.1-.6 2.4c-.4 1.6-.8 3.8-2.4 5.7-1.4 1.7-2.9 1.9-3.5 1.9-1.2 0-1.9-.6-2-1.5 0-.8.7-1.3 1.2-1.3.6 0 1.1.5 1.1 1s-.2.6-.4.6c-.1.1-.3.2-.3.4 0 .1.1.3.4.3.5 0 .8-.3 1.1-.5 1.2-.9 1.6-2.7 2.2-5.7l.1-.7.7-3.2c-.8-.6-1.3-1.4-2.4-1.7-.6-.1-1.1.1-1.5.5-.4.5-.2 1.1.2 1.5l.7.6c.7.8 1.2 1.6 1 2.5-.3 1.5-2 2.6-4 1.9-1.8-.6-2-1.8-1.8-2.5.2-.6.6-.7 1.1-.6.5.2.6.7.6 1.2l-.1.3c-.2.1-.3.3-.3.4-.1.4.4.6.7.7.7.3 1.6-.2 1.8-.8a1 1 0 0 0-.4-1.1l-.7-.8c-.4-.4-1.1-1.4-.7-2.6.1-.5.4-.9.7-1.3a4 4 0 0 1 2.8-.6c1.2.4 1.8 1.1 2.6 1.8.5-1.2 1-2.4 1.8-3.5.9-.9 1.9-1.6 3.1-1.7 1.3.2 2.2.7 2.2 1.6 0 .4-.2 1.1-.9 1.1z"
          ></path>
        </svg>Symfony 7
        {{ 'layout.footer.and'|trans }}
        <span class="ri-tailwind-css-fill" aria-hidden="true"></span>
        Tailwind CSS 4
      </div>
      <div class="grow text-left">
        {{ ('layout.footer.version'|trans) ~ ' ' ~ env.versioning.version ~ ' - ' ~ ('layout.footer.releaseDate'|trans) ~ ' '
          ~ (env.versioning.release_date|format_datetime('short', 'none')) }}
      </div>
    </footer>
  </body>
</html>
