<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if (turbo_force_reload|default(false)) == true %}
      <meta name="turbo-visit-control" content="reload" />
    {% endif %}
    <meta name="turbo-prefetch" content="{{ env.turbo.enable_prefetch ? 'true' : 'false' }}" />

    <link rel="icon" href="{{ asset('build/images/favicon.png') }}" />

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>
  </head>
  <body class="flex flex-col min-h-screen text-zinc-900 bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100" data-controller="switch-theme">
    {# Bar to show the environment, not visible in prod #}
    {% if env.app.env != 'prod' %}
      <div class="flex justify-around p-0 m-0 text-center font-bold app-env-{{ env.app.env }}">
        {%- for i in 1..10 -%}
          <div>
            {{ ('layout.env.' ~ env.app.env)|trans|upper }}
          </div>
        {%- endfor -%}
      </div>
    {% endif %}

    {# Button to switch role, onyl visible in dev/test and if keycloak is mocked #}
    {% if (env.app.env == 'dev' or env.app.env == 'test') and env.mock.keycloak_enable %}
      <div class="text-right font-semibold">
        <a href="{{ path('home_switch') }}">PASSER EN ROLE {{ app.user.isAdmin ? 'USER' : 'ADMIN' }}</a>
      </div>
    {% endif %}

    {# Skip to content link for screen reader #}
    {# <div class="app-navbar-bg-color ps-3 app-skip-link">
      <a class="icon-link visually-hidden-focusable" href="#main-content">{{ 'aria.skipToContent'|trans }}</a>
    </div> #}

    <header>
      <div>
        <button>Switch theme</button>
        <ul>
          <li><span class="ri-sun-fill" aria-hidden="true"></span>Light</li>
          <li><span class="ri-moon-fill" aria-hidden="true"></span>Dark</li>
          <li><span class="ri-home-gear-fill" aria-hidden="true"></span>System</li>
        </ul>
      </div>
    </header>

    <div class="text-left">
      {{ app.user.id }} - {{ app.user.username }} - <img src="{{ app.user.toArray.picture }}" style="display: inline; width: 50px;" /> - {{
        app.user.roles|reduce((carry, value, key) => carry ~ value ~ ', ')
      }}
    </div>

    {# The MAIN block must be redefined on each page, including the flash block with the bood wrapper #}
    <main class="grow" id="main-content">
      {% block main %}
        {# {{ block('flash', 'theme/flash.html.twig') }} #}
        <div class="text-center">
          Some content !
        </div>
      {% endblock %}
    </main>

    <footer class="text-center font-light italic">
      Made with Symfony + Tailwind CSS | Mise à jour le + version
    </footer>
  </body>
</html>
