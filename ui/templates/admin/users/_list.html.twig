{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-admin-users-list">
  {% if errorData is not null %}
    {{ m.flash('flash-error-admin-users-list', 'error', errorData.textKey, 'full', true, false) }}
  {% else %}
    {% set bar %}
      {{ m.button('button-admin-users-refresh', 'button.refresh', 'ri-reset-left-line', 'tooltip', { 'data-action': 'click->turboframe#reload' }) }}
    {% endset %}

    {% set head %}
      <tr>
        <th scope="col" class="px-4 py-3">{{ 'admin.users.list.uuid'|trans }}</th>
        <th scope="col" class="w-8 px-2 py-3" aria-label="{{ 'button.expand'|trans }}"></th>
      </tr>
    {% endset %}

    {% set body %}
      {% for userInfoData in userListData.userInfoDataList %}
        <tr class="border-zinc-500 {{ not loop.last ? ' border-b' }}">
          <td class="px-4 py-2">{{ userInfoData.uuid }}</td>
          <td class="px-2 py-2 text-left">
            {% set buttonId = 'button-admin-users-edit-' ~ userInfoData.uuid %}
            {% set turboframeRemoveId = 'turboframe-admin-users-edit-' ~ userInfoData.uuid %}
            {{ m.button(buttonId, 'button.expand', 'ri-arrow-right-s-line', 'off') }}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="px-4 py-2 text-sm italic">{{ 'user.keys.list.noKey'|trans }}</td>
        </tr>
      {% endfor %}
    {% endset %}

    {{ m.table(bar, head, body) }}
  {% endif %}
</turbo-frame>
