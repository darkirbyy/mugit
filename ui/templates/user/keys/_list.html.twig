{% import 'theme/macro.html.twig' as m %}

<turbo-frame id="turboframe-user-keys-list">
  {% if errorData is not null %}
    {{ m.flash('flash-error-user-keys-list', 'error', errorData.textKey, 'full', true, false) }}
  {% else %}
    {% set barRight %}
      {% set buttonId = 'button-user-keys-add' %}
      {% set dropdownId = 'dropdown-user-keys-add' %}
      {% set turboframeId = 'turboframe-user-keys-add' %}
      {{ m.button(buttonId, 'b', 'user.keys.list.addNew', 'ri-add-large-line', 'normal', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'bottom-end' }) }}
      {{ m.dropdown_start(dropdownId, { class: ['min-w-100'] }) }}
      {% set extra %}
        <turbo-frame id="{{ turboframeId }}" loading="lazy" src="{{ path('user_keys_add', { uuid: userKeysListData.uuid }) }}" data-controller="turboframe">
          {{ m.spinner(1, false, 'p-1 gap-1 grid-cols-1 min-w-2xs') }}
        </turbo-frame>
      {% endset %}
      {{ m.dropdown_item('button-user-keys-add-new', 'b', 'user.keys.list.addNew', 'ri-add-line', null, extra, true) }}
      {{ m.dropdown_end() }}
      {{ m.button('button-user-keys-refresh', 'b', 'button.refresh', 'ri-reset-left-line', 'tooltip', { 'data-action': 'click->turboframe#reload' }) }}
    {% endset %}

    {% set head %}
      <tr>
        <th scope="col" class="px-4 py-3">{{ 'user.keys.list.key'|trans }}</th>
        <th scope="col" class="px-4 py-3 whitespace-nowrap">{{ 'user.keys.list.dateAdded'|trans }}</th>
        <th scope="col" class="px-4 py-3">{{ 'user.keys.list.comment'|trans }}</th>
        <th scope="col" class="w-8 px-2 py-3" aria-label="{{ 'button.edit'|trans }}"></th>
      </tr>
    {% endset %}

    {% set body %}
      <tbody>
        {% for userKeysInfoData in userKeysListData.userKeysInfoDataList %}
          <tr class="border-zinc-500 {{ not loop.first ? ' border-t' }}">
            <td class="px-4 py-2 font-medium">{{ userKeysInfoData.key|user_keys_replace_ellipsis(15, 5) }}</td>
            <td class="px-4 py-2">{{ userKeysInfoData.dateAdded|format_datetime('short') }}</td>
            <td class="px-4 py-2">{{ userKeysInfoData.comment }}</td>
            <td class="px-2 py-2 text-left">
              {% set buttonId = 'button-user-keys-edit-' ~ (userKeysInfoData.key|user_keys_hash) %}
              {% set dropdownId = 'dropdown-user-keys-edit-' ~ (userKeysInfoData.key|user_keys_hash) %}
              {% set turboframeRemoveId = 'turboframe-user-keys-remove-' ~ (userKeysInfoData.key|user_keys_hash) %}
              {{ m.button(buttonId, 'b', 'button.edit', 'ri-more-2-line', 'off', { 'data-dropdown-toggle': dropdownId, 'data-dropdown-placement': 'left-start' }) }}
              {{ m.dropdown_start(dropdownId, { class: ['min-w-60'] }) }}
              {% set extra %}
                <turbo-frame
                  id="{{ turboframeRemoveId }}"
                  loading="lazy"
                  src="{{ path('user_keys_remove', { uuid: userKeysListData.uuid, key: userKeysInfoData.key }) }}"
                  data-controller="turboframe"
                >
                  {{ m.spinner(1, false, 'p-1 gap-1 grid-cols-1 min-w-2xs') }}
                </turbo-frame>
              {% endset %}
              {% set buttonId = 'button-user-keys-remove-' ~ (userKeysInfoData.key|user_keys_hash) %}
              {{ m.dropdown_item(buttonId, 'b', 'user.keys.list.remove', 'ri-delete-bin-line', { class: ['text-red-900', 'dark:text-red-400'] }, extra) }}
              {{ m.dropdown_end() }}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="px-4 py-2 text-sm italic">{{ 'user.keys.list.noKey'|trans }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {% endset %}

    {{ m.table(null, barRight, head, body) }}
  {% endif %}
</turbo-frame>
