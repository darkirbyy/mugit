{
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@eslint/js": "^10.0.1",
        "@hotwired/stimulus": "^3.2.2",
        "@hotwired/turbo": "^8.0",
        "@prettier/plugin-php": "^0.25.0",
        "@symfony/stimulus-bridge": "^4.0.1",
        "@symfony/ux-turbo": "file:vendor/symfony/ux-turbo/assets",
        "@symfony/webpack-encore": "^7.2.0",
        "@zackad/prettier-plugin-twig": "^0.17.0",
        "core-js": "^3.49.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.9.0",
        "lightningcss": "^1.33.0",
        "path": "^0.12.7",
        "prettier": "^3.9.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "webpack": "5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-notifier": "^1.15.0"
    },
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "dev-server": "encore dev-server",
        "dev-watch": "encore dev --watch",
        "build": "encore production --progress",
        "pretty-file": "prettier --write --config linter/.prettierrc.json",
        "pretty-all": "npm run pretty-file \"src/**/*.php\" \"tests/**/*.php\" \"templates/**/*.twig\" \"assets/styles/**/*.css\" \"assets/controllers/**/*.js\"",
        "lint-css-file": "stylelint --fix --cache --cacheLocation var/cache/linter/ --config linter/.stylelint.config.json",
        "lint-js-file": "eslint --fix --cache --cache-location var/cache/linter/ --config linter/.eslint.config.mjs"
    },
    "allowScripts": {
        "core-js": false
    }
}
